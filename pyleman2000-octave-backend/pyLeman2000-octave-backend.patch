diff --git a/docker/octave/Dockerfile b/docker/octave/Dockerfile
new file mode 100644
index 0000000..ce08799
--- /dev/null
+++ b/docker/octave/Dockerfile
@@ -0,0 +1,57 @@
+# Leman (2000) Octave backend for pyLeman2000.
+#
+# Builds a license-free image from the Octave-compatible IPEM Toolbox fork.
+# The container entrypoint matches the MATLAB MCR image CLI so
+# pyleman2000.docker_runner can use either backend unchanged:
+#
+#   /leman_2000_docker.sh <input.wav> <output.json> <local_csv> <global_csv> <detail>
+#
+# Build (from the pyLeman2000 repository root):
+#
+#   docker build -f docker/octave/Dockerfile -t pyleman2000-octave:dev docker/octave
+#
+# Pin IPEM_REF to a commit SHA of cms-cambridge/IPEMToolbox for reproducibility.
+
+ARG OCTAVE_BASE=docker.io/gnuoctave/octave:10.3.0
+FROM ${OCTAVE_BASE}
+
+USER root
+
+ARG IPEM_REPO=https://github.com/cms-cambridge/IPEMToolbox.git
+# Pin to the Octave-compat fork revision (update when merging toolbox PRs).
+ARG IPEM_REF=fc2dc4f9dbcd9df50da16a5e1a228284e9d81cd0
+
+ENV DEBIAN_FRONTEND=noninteractive \
+    OCTAVE_HISTFILE=/tmp/octave-history \
+    IPEM_ROOT=/opt/IPEMToolbox \
+    LD_LIBRARY_PATH=
+
+RUN apt-get update \
+    && apt-get install -y --no-install-recommends \
+        build-essential \
+        ca-certificates \
+        git \
+        libsndfile1 \
+    && rm -rf /var/lib/apt/lists/*
+
+RUN octave --no-gui --quiet --eval "\
+  pkg install -forge io; \
+  pkg install -forge control; \
+  pkg install -forge signal; \
+  pkg list;"
+
+RUN git clone --filter=blob:none "${IPEM_REPO}" "${IPEM_ROOT}" \
+    && cd "${IPEM_ROOT}" \
+    && git checkout "${IPEM_REF}" \
+    && mkdir -p AuditoryModel/Octave_UNIX/Release IPEMToolbox/Temp \
+    && cd AuditoryModel/Octave_UNIX \
+    && make \
+    && make install \
+    && test -f "${IPEM_ROOT}/IPEMToolbox/Common/IPEMProcessAuditoryModelSafe.mex"
+
+COPY leman_2000.m /opt/leman_2000.m
+COPY leman_2000_docker.sh /leman_2000_docker.sh
+RUN chmod +x /leman_2000_docker.sh
+
+WORKDIR /opt
+ENTRYPOINT ["/leman_2000_docker.sh"]
diff --git a/docker/octave/leman_2000.m b/docker/octave/leman_2000.m
new file mode 100644
index 0000000..33e58d1
--- /dev/null
+++ b/docker/octave/leman_2000.m
@@ -0,0 +1,89 @@
+function leman_2000(in_file, out_file, local_decay_sec, global_decay_sec, detail)
+% Octave port of pmcharrison/leman_2000.m for the pyLeman2000 Docker backend.
+%
+% Writes JSON with the same top-level schema as the MATLAB MCR binary:
+%   audio_length_sec, num_channels, sample_rate,
+%   local_global_comparison[{local_decay_sec, global_decay_sec, running_correlation}],
+%   and optionally auditory_nerve / periodicity_pitch when detail > 1.
+
+  toolbox_dir = '/opt/IPEMToolbox/IPEMToolbox';
+  addpath(toolbox_dir);
+  cd(toolbox_dir);
+  IPEMSetup;
+
+  [in_dir, in_file_key, in_file_ext] = fileparts(in_file);
+  in_file_name = strcat(in_file_key, in_file_ext);
+  [s, fs] = IPEMReadSoundFile(in_file_name, in_dir);
+  num_channels = size(s, 1);
+
+  local_decay_sec = parse_array(local_decay_sec);
+  global_decay_sec = parse_array(global_decay_sec);
+
+  if (num_channels == 2)
+    s = (s(1, :) + s(2, :)) / 2;
+  end
+
+  audio_length_sec = length(s) / fs;
+
+  [ANI, ANIFreq, ANIFilterFreqs] = IPEMCalcANI(s, fs);
+  [PP, PPFreq, PPPeriods, PPFANI] = IPEMPeriodicityPitch(ANI, ANIFreq);
+
+  res = struct();
+  res.audio_length_sec = audio_length_sec;
+  res.num_channels = num_channels;
+  res.sample_rate = fs;
+
+  if (detail > 1)
+    res.auditory_nerve = struct( ...
+      'images', ANI, ...
+      'sample_freq', ANIFreq, ...
+      'filter_freqs', ANIFilterFreqs);
+    res.periodicity_pitch = struct( ...
+      'signal', PP, ...
+      'sample_freq', PPFreq, ...
+      'pitch_periods', PPPeriods, ...
+      'filtered_auditory_nerve_images', PPFANI);
+  end
+
+  % Match MATLAB combvec(local, global): local varies fastest.
+  n_local = numel(local_decay_sec);
+  n_global = numel(global_decay_sec);
+  n_combinations = n_local * n_global;
+  comparisons = cell(n_combinations, 1);
+  combo_idx = 0;
+  for gi = 1:n_global
+    for li = 1:n_local
+      combo_idx = combo_idx + 1;
+      local_decay = local_decay_sec(li);
+      global_decay = global_decay_sec(gi);
+      fprintf(1, 'Computing running correlation %d/%d...\n', combo_idx, n_combinations);
+      [~, ~, ~, ~, running_corr] = IPEMContextualityIndex( ...
+        PP, PPFreq, PPPeriods, [], local_decay, global_decay, [], 0);
+      comparisons{combo_idx} = struct( ...
+        'local_decay_sec', local_decay, ...
+        'global_decay_sec', global_decay, ...
+        'running_correlation', running_corr(:)');
+    end
+  end
+  res.local_global_comparison = comparisons;
+
+  payload = jsonencode(res);
+  fid = fopen(out_file, 'w');
+  if (fid < 0)
+    error('leman_2000: could not open output file %s', out_file);
+  end
+  fwrite(fid, payload);
+  fclose(fid);
+end
+
+function array = parse_array(x)
+  if (ischar(x) || isstring(x))
+    parts = strsplit(char(x), ',');
+    array = zeros(1, numel(parts));
+    for i = 1:numel(parts)
+      array(i) = str2double(strtrim(parts{i}));
+    end
+  else
+    array = x(:)';
+  end
+end
